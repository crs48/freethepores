---
import Layout from '../../layouts/Layout.astro';
import { topics } from '../../data/topics';
import { getSource } from '../../data/sources';
import { href, reviewed } from '../../data/site';
import { fieldNotes } from '../../data/field-guide';
export const getStaticPaths = () => topics.map(topic => ({ params: { slug: topic.slug }, props: { topic } }));
const { topic } = Astro.props;
const fieldNote = fieldNotes[topic.slug];
const cited = [...new Set([...topic.sections.flatMap(section => section.sources), ...fieldNote.sources])].map(getSource);
const readingMinutes = Math.max(2, Math.ceil(topic.sections.flatMap(section => section.paragraphs).join(' ').split(/\s+/).length / 200));
const nextTopic = topics[(topics.findIndex(entry => entry.slug === topic.slug) + 1) % topics.length];
---
<Layout title={topic.title} description={topic.description}>
  <section class="page-top article-top"><div class="wrap"><a class="eyebrow underline" href={href('research/')}>The big questions / {topic.label}</a><span class="article-symbol" aria-hidden="true">{fieldNote.icon}</span><h1>{topic.title}</h1><p class="lead">{topic.description}</p><div class="article-meta"><span class="pill">{topic.verdict}</span><span>{readingMinutes} min read · {cited.length} sources</span></div></div></section>
  <div class="wrap section reading-layout">
    <aside class="reading-sidebar"><div class="reading-sticky"><span class="eyebrow">In this field note</span><nav class="article-toc" aria-label="On this page"><a href="#quick-take">The quick take</a>{topic.sections.map((section, i) => <a href={`#section-${i + 1}`}>{section.title}</a>)}<a href="#try-this">Bring it to the bathroom</a><a href="#sources">Follow the footnotes</a></nav><p class="fine muted">Original library: {reviewed}. New and rechecked sources carry their own dates.</p><a href={href('about/#method')}>How we read the evidence</a></div></aside>
    <article class="prose">
      <div class="callout yellow quick-take" id="quick-take"><span class="eyebrow">The quick take</span><p>{topic.takeaway}</p><span class="fine muted">Our reading of the evidence. The detail and limits follow.</span></div>
      {topic.sections.map((section, i) => <section class="article-section" id={`section-${i + 1}`}><span class="section-index" aria-hidden="true">0{i + 1}</span><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.sources.length > 0 && <div class="citation-links">{section.sources.map(id => { const source = getSource(id); return <a href={href(`research/#${id}`)}>{source.citation.split(' · ')[0]} · {source.year}</a>; })}</div>}</section>)}
      <section class="field-note" id="try-this"><span class="eyebrow">Bring it to the bathroom</span><h2>A small next step.</h2><p>{fieldNote.action}</p><p><strong>Keep in mind:</strong> {fieldNote.watch}</p><div class="citation-links">{fieldNote.sources.map(id => <a href={href(`research/#${id}`)}>{getSource(id).title}</a>)}</div><a class="text-link" href={href('less/')}>Give your routine a job interview ↗</a></section>
      <div class="article-limit"><h3>What we still don’t know</h3><p class="mt-4">{topic.unknown}</p></div>
      <section id="sources"><h2>Follow the footnotes.</h2><ol>{cited.map(source => <li><a href={source.url}>{source.title}</a><span class="block fine muted">{source.citation} · {source.year}. {source.access}.</span></li>)}</ol></section>
      <p class="fine muted">These notes explain published evidence; they are not a personalized treatment plan. For ongoing symptoms or changes to prescribed care, talk with a qualified clinician.</p>
      <a class="next-note" href={href(`research/${nextTopic.slug}/`)}><span class="eyebrow">Keep the curiosity going</span><strong>{nextTopic.title}</strong><span aria-hidden="true">↗</span></a><a class="text-link" href={href('research/')}>All seven questions</a>
    </article>
  </div>
</Layout>
